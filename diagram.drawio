<mxfile host="app.diagrams.net">
  <diagram name="SAP BTP Landscape" id="sap-btp">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- BTP outer container (filled) -->
        <mxCell id="btp" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#EBF8FF;arcSize=32;absoluteArcSize=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="160" y="40" width="640" height="620" as="geometry" />
        </mxCell>
        <!-- SAP logo + BTP title (mandatory for BTP area) -->
        <mxCell id="btpLogo" value="SAP BTP" style="image;image=img/lib/sap/SAP_Logo.svg;editableCssRules=.*;verticalLabelPosition=middle;labelBackgroundColor=none;verticalAlign=middle;imageAspect=0;labelPosition=right;align=left;fontSize=16;fontStyle=1;spacingLeft=0;fontColor=#002A86;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="175" y="51" width="37" height="19" as="geometry" />
        </mxCell>

        <!-- Subaccount container (unfilled, alternating) -->
        <mxCell id="sub" value="Subaccount" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#ffffff;arcSize=32;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;fontSize=12;fontColor=default;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="190" y="80" width="580" height="340" as="geometry" />
        </mxCell>

        <!-- BWZ service (icon only, no wrapping box per STYLES.md rule) -->
        <mxCell id="bwz" value="SAP Build Work Zone" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Build_Work_Zone_-_Standard_Edition;" vertex="1" parent="1">
          <mxGeometry x="292" y="215" width="56" height="56" as="geometry" />
        </mxCell>

        <!-- Task Center service (icon only, no wrapping box per STYLES.md rule) -->
        <mxCell id="tc" value="SAP Task Center" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Task_Center;" vertex="1" parent="1">
          <mxGeometry x="612" y="215" width="56" height="56" as="geometry" />
        </mxCell>

        <!-- CIS service box (inside BTP, outside Subaccount) -->
        <mxCell id="cisBox" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#ffffff;arcSize=24;absoluteArcSize=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cis" value="SAP Cloud Identity Services" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Cloud_Identity_Service;" vertex="1" parent="1">
          <mxGeometry x="452" y="505" width="56" height="56" as="geometry" />
        </mxCell>

        <!-- End User (non-SAP, grey) -->
        <mxCell id="eu" value="End User" style="shape=umlActor;verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;html=1;outlineConnect=0;fillColor=#F5F6F7;strokeColor=#475E75;fontColor=#1D2D3E;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- Application Clients (non-SAP, grey) -->
        <mxCell id="ac" value="Application Clients&#10;Mobile or Desktop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F7;strokeColor=#475E75;arcSize=16;absoluteArcSize=1;fontSize=12;fontColor=#1D2D3E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- On-Premise Solutions (SAP, external - blue filled) -->
        <mxCell id="onprem" value="SAP On-Premise&#10;Solutions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#0070F2;arcSize=16;absoluteArcSize=1;fontSize=12;fontColor=#1D2D3E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="830" y="170" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Cloud Solutions (SAP, external - blue filled) -->
        <mxCell id="cloud" value="SAP Cloud&#10;Solutions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#0070F2;arcSize=16;absoluteArcSize=1;fontSize=12;fontColor=#1D2D3E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="830" y="290" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 3rd-party Identity Provider (non-SAP, grey) -->
        <mxCell id="idp" value="3rd-party&#10;Identity Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F7;strokeColor=#475E75;arcSize=16;absoluteArcSize=1;fontSize=12;fontColor=#1D2D3E;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="830" y="515" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Data flows: orthogonal (折れ曲がった直線) -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475E75;fontFamily=Helvetica;fontColor=default;targetPerimeterSpacing=15;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;" edge="1" parent="1" source="eu" target="ac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475E75;fontFamily=Helvetica;fontColor=default;targetPerimeterSpacing=15;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;" edge="1" parent="1" source="ac" target="bwz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BWZ → TC: horizontally aligned → straight line (直線) -->
        <mxCell id="e3" value="" style="endArrow=blockThin;html=1;strokeColor=#475e75;bendable=1;rounded=0;endFill=1;endSize=4;strokeWidth=1.5;startSize=4;startArrow=none;startFill=0;" edge="1" parent="1" source="bwz" target="tc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475E75;fontFamily=Helvetica;fontColor=default;targetPerimeterSpacing=15;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;" edge="1" parent="1" source="tc" target="onprem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475E75;fontFamily=Helvetica;fontColor=default;targetPerimeterSpacing=15;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;" edge="1" parent="1" source="tc" target="cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Trust: orthogonal, pink, bidirectional -->
        <mxCell id="e6" value="trust" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CC00DC;fontFamily=Helvetica;fontColor=#CC00DC;targetPerimeterSpacing=15;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=blockThin;startFill=1;fontSize=10;" edge="1" parent="1" source="sub" target="cisBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Authentication delegation: orthogonal, green, bidirectional -->
        <mxCell id="e7" value="delegates auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#188918;fontFamily=Helvetica;fontColor=#188918;targetPerimeterSpacing=15;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=blockThin;startFill=1;fontSize=10;" edge="1" parent="1" source="cis" target="idp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
