    <mxCell id="bwz_title" value="SAP Build Work Zone" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;fontColor=#002A86;fontFamily=Helvetica;" vertex="1" parent="1">
      <mxGeometry x="315" y="142" width="130" height="32" as="geometry"/>
    </mxCell>

    <!-- App container (inside BWZ) -->
    <mxCell id="bwz_apps" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#ffffff;arcSize=32;absoluteArcSize=1;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="275" y="185" width="170" height="130" as="geometry"/>
    </mxCell>

    <!-- Purchase Requisition App (icon placeholder + label) -->
    <mxCell id="ui5" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475E75;fillColor=none;dashed=1;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="295" y="205" width="40" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="ui5_label" value="Purchase&#xa;Requisition App" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=10;fontColor=default;fontFamily=Helvetica;" vertex="1" parent="1">
      <mxGeometry x="280" y="249" width="70" height="30" as="geometry"/>
    </mxCell>

    <!-- My Inbox (icon placeholder + label) -->
    <mxCell id="inbox" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475E75;fillColor=none;dashed=1;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="390" y="205" width="40" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="inbox_label" value="My Inbox" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=10;fontColor=default;fontFamily=Helvetica;" vertex="1" parent="1">
      <mxGeometry x="385" y="249" width="50" height="30" as="geometry"/>
    </mxCell>

    <!-- ===== SAP Build Process Automation ===== -->
    <mxCell id="spa" value="SAP Build&#xa;Process Automation" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Build_Process_Automation" vertex="1" parent="1">
      <mxGeometry x="510" y="235" width="50" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== SAP Destination Service ===== -->
    <mxCell id="dest" value="SAP Destination&#xa;Service" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Destination_service" vertex="1" parent="1">
      <mxGeometry x="620" y="235" width="50" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== SAP Connectivity Service ===== -->
    <mxCell id="conn" value="SAP Connectivity&#xa;Service" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Connectivity_Service" vertex="1" parent="1">
      <mxGeometry x="720" y="235" width="50" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== SAP Cloud Identity Services (BTP内、Subaccount外) ===== -->
    <mxCell id="cis" value="SAP Cloud Identity&#xa;Services" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=SAP_Cloud_Identity_Service" vertex="1" parent="1">
      <mxGeometry x="495" y="410" width="50" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== SAP S/4HANA Private Cloud (BTP外) ===== -->
    <mxCell id="s4" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#EBF8FF;arcSize=32;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#002A86;" vertex="1" parent="1">
      <mxGeometry x="860" y="175" width="170" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="s4_logo" value="S/4HANA&#xa;Private Cloud" style="image;image=img/lib/sap/SAP_Logo.svg;editableCssRules=.*;verticalLabelPosition=middle;labelBackgroundColor=none;verticalAlign=middle;imageAspect=0;labelPosition=right;align=left;fontSize=12;fontStyle=1;spacingLeft=0;fontColor=#002A86;spacing=0;" vertex="1" parent="1">
      <mxGeometry x="875" y="186" width="37" height="19" as="geometry"/>
    </mxCell>

    <!-- Cloud Connector (inside S/4HANA) -->
    <mxCell id="cc" value="Cloud&#xa;Connector" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;fontSize=12;fontColor=default;fontFamily=Helvetica;SAPIcon=Cloud_Connector2" vertex="1" parent="1">
      <mxGeometry x="920" y="235" width="50" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== End User (Generic Icon placeholder) ===== -->
    <mxCell id="eu" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475E75;fillColor=none;dashed=1;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="240" width="40" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="eu_label" value="End User" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=default;fontFamily=Helvetica;" vertex="1" parent="1">
      <mxGeometry x="20" y="284" width="80" height="20" as="geometry"/>
    </mxCell>

    <!-- ===== Application Clients (Generic Icon placeholder) ===== -->
    <mxCell id="ac" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475E75;fillColor=none;dashed=1;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="140" y="240" width="40" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="ac_label" value="Application Clients" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=default;fontFamily=Helvetica;" vertex="1" parent="1">
      <mxGeometry x="107" y="284" width="106" height="20" as="geometry"/>
    </mxCell>

    <!-- ===== Edges: Main Flow ===== -->

    <!-- End User → Application Clients (straight) -->
    <mxCell id="e1" style="endArrow=blockThin;html=1;strokeColor=#475e75;rounded=0;endFill=1;endSize=4;strokeWidth=1.5;startSize=4;startArrow=none;startFill=0;" edge="1" source="eu" target="ac" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Application Clients → BWZ (orthogonal) -->
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475E75;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ac" target="bwz" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- BWZ → SPA (orthogonal) -->
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475E75;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="bwz" target="spa" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- SPA → Destination (straight) -->
    <mxCell id="e5" style="endArrow=blockThin;html=1;strokeColor=#475e75;rounded=0;endFill=1;endSize=4;strokeWidth=1.5;startSize=4;startArrow=none;startFill=0;" edge="1" source="spa" target="dest" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Destination → Connectivity (straight) -->
    <mxCell id="e6" style="endArrow=blockThin;html=1;strokeColor=#475e75;rounded=0;endFill=1;endSize=4;strokeWidth=1.5;startSize=4;startArrow=none;startFill=0;" edge="1" source="dest" target="conn" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Connectivity → Cloud Connector (straight) -->
    <mxCell id="e7" style="endArrow=blockThin;html=1;strokeColor=#475e75;rounded=0;endFill=1;endSize=4;strokeWidth=1.5;startSize=4;startArrow=none;startFill=0;" edge="1" source="conn" target="cc" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ===== Edges: Trust / Authentication ===== -->

    <!-- Subaccount ↔ CIS (trust, pink bidirectional) -->
    <mxCell id="e8" value="trust" style="endArrow=blockThin;html=1;strokeColor=#CC00DC;fontColor=#CC00DC;fontFamily=Helvetica;rounded=0;endFill=1;endSize=4;startSize=4;startArrow=blockThin;startFill=1;strokeWidth=1.5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="sa" target="cis" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Application Clients → CIS (authenticate, green) -->
    <mxCell id="e9" value="authenticate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#188918;fontColor=#188918;fontFamily=Helvetica;endSize=4;startSize=4;endArrow=blockThin;endFill=1;strokeWidth=1.5;startArrow=none;startFill=0;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ac_label" target="cis" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
